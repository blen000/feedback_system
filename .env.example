DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bank_feedback?schema=public"

# Random secret used to sign/verify auth-related tokens. Generate a new one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shown on the public feedback page header (optional)
NEXT_PUBLIC_BANK_NAME=""

# Outgoing email (optional). When set, new users receive an invitation link and "Forgot password" works.
# Without SMTP_HOST the app falls back to administrator-set passwords.
SMTP_HOST=""
SMTP_PORT=587            # 587 = STARTTLS (required), 465 = implicit TLS
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@example.com"
# Only for a mail server using a private / self-signed certificate. Disables certificate checking: keep "false" if you can.
SMTP_ALLOW_SELF_SIGNED="false"
# Local trials: "console" prints emails to the server log instead of sending them.
# MAIL_DRIVER="console"

# Seeding (npm run db:seed / db:seed:prod). Sets the password of the seeded super admin (admin@bank.local).
# Development: also applied to the demo accounts. Production: REQUIRED; the admin must change it at first sign-in.
# SEED_PASSWORD="ChangeMe123!"

# High-severity security alerts (lockouts, role changes, admin password resets) are emailed here.
# Comma-separated. Default: every active SUPER_ADMIN user.
# SECURITY_ALERT_EMAILS="security@example.com"
